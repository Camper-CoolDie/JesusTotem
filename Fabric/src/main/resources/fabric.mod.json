{
  "schemaVersion": 1,
  "id": "$mod_id",
  "version": "$mod_version",
  "name": "$mod_name",
  "description": "$mod_description",
  "authors": [
    "$mod_author"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/godly-totem",
    "sources": "https://github.com/Camper-CoolDie/JesusTotem",
    "issues": "https://github.com/Camper-CoolDie/JesusTotem/issues"
  },
  "license": "$mod_license",
  "icon": "assets/jesustotem/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.cooldie.jesustotem.JesusTotemClient"
    ],
    "modmenu": [
      "com.cooldie.jesustotem.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "jesustotem.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "$minecraft_version_range"
  }
}
